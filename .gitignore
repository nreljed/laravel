# Workspace packages are first-class source (tracked); ignore only their install output
packages/*/node_modules/
packages/*/vendor/
packages/**/dist/

# Debug/temp files (root only)
/*.txt
/*.html
/*.png
/_*.php
/table-inspect.json
/sql/*.sql

# LocalWP auto-generated
/.envrc

# Laravel Boost auto-generated files
.cursorrules
CLAUDE.md
.github/copilot-instructions.md

# .ai/ is mostly Boost-generated (guidelines/, skills/), so it stays ignored --
# but .ai/rules/ is hand-written, path-scoped agent guidance that took real
# incidents to produce. Ignoring the whole directory meant none of it reached a
# fresh clone, so an agent only ever saw the rules that happened to exist on the
# machine it was written on. Ignore the contents, re-include the rules.
.ai/*
!.ai/rules/

boost.json
