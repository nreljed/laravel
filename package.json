    "@tanstack/react-table": "^8.21.3",
    "@types/prismjs": "^1.26.6",
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.2",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "esbuild": "^0.28.1",
    "input-otp": "^1.4.2",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
