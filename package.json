{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint resources/js/ packages/dashboard-core/resources/js/ packages/dashboard-core/src/Blog/Resources/js/ app/TestPosts/Resources/js/",
    "lint:fix": "eslint resources/js/ packages/dashboard-core/resources/js/ packages/dashboard-core/src/Blog/Resources/js/ app/TestPosts/Resources/js/ --fix",
    "format": "prettier --write \"resources/js/**/*.{ts,tsx,json,css}\" \"packages/dashboard-core/resources/js/**/*.{ts,tsx,json}\" \"packages/dashboard-core/src/*/Resources/js/**/*.{ts,tsx,json}\" \"app/TestPosts/Resources/js/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"resources/js/**/*.{ts,tsx,json,css}\" \"packages/dashboard-core/resources/js/**/*.{ts,tsx,json}\" \"packages/dashboard-core/src/*/Resources/js/**/*.{ts,tsx,json}\" \"app/TestPosts/Resources/js/**/*.{ts,tsx,json}\"",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:ci": "npm run lint && npm run typecheck && npm run format:check && npm run test && php vendor/bin/pint && php vendor/bin/phpstan analyse --no-progress --memory-limit=1G && php vendor/bin/rector process --dry-run && php artisan test --parallel --compact"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ],
    "*.php": [
      "php vendor/bin/pint"
    ]
  },
  "overrides": {
    "nanoid": "^3.3.18"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@emnapi/core": "^1.11.1",
