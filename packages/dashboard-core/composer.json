{
  "name": "nreljed/dashboard-core",
  "description": "Shared dashboard core for the Cost Breaker 360 product family (master app, Shop, Booking).",
  "version": "0.1.0",
  "type": "library",
  "license": "proprietary",
  "authors": [
    {
      "name": "Nreljed"
    }
  ],
  "require": {
    "php": "^8.4",
    "inertiajs/inertia-laravel": "^3.0",
    "intervention/image-laravel": "^4.0",
    "laravel/ai": "^0.10",
    "laravel/framework": "^13.0",
    "laravel/sanctum": "^4.0",
    "minishlink/web-push": "^11.0",
    "tightenco/ziggy": "^2.6"
  },
  "require-dev": {
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Nreljed\\DashboardCore\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Nreljed\\DashboardCore\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Nreljed\\DashboardCore\\DashboardCoreServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
