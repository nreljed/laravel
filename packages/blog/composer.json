{
    "name": "nreljed/blog",
    "description": "Blog feature for the Nreljed dashboard platform (posts, categories, tags, public blog, SEO generation).",
    "version": "0.1.7",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Nreljed"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0",
        "nreljed/platform": "^0.1|^0.2"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Nreljed\\Blog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nreljed\\Blog\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nreljed\\Blog\\BlogServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/nreljed/platform.git"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
