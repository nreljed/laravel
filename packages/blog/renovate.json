{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":preserveSemverRanges"
  ],
  "timezone": "UTC",
  "schedule": ["before 6am on monday"],
  "dependencyDashboard": true,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "platformAutomerge": true,
  "rebaseWhen": "conflicted",
  "ignoreDeps": [
    "nreljed/platform",
    "nreljed/blog",
    "nreljed/shop-module",
    "nreljed/booking-module",
    "nreljed/marketing-module"
  ],
  "postUpdateOptions": [
    "composerWithAll",
    "npmDedupe"
  ],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchManagers": ["composer"],
      "groupName": "php-deps",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "matchManagers": ["npm", "pnpm"],
      "groupName": "npm-deps",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major"]
    },
    {
      "matchPackagePatterns": ["^laravel/"],
      "groupName": "laravel-ecosystem",
      "automerge": false,
      "labels": ["dependencies", "laravel"]
    },
    {
      "matchPackageNames": ["laravel/ai", "lexical"],
      "groupName": "ai-editor-blocked",
      "automerge": false,
      "labels": ["dependencies", "blocked-by-platform"]
    },
    {
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "react-core",
      "automerge": false,
      "labels": ["dependencies", "core-framework"]
    },
    {
      "matchPackageNames": ["vite", "@vitejs/plugin-react"],
      "groupName": "vite-tooling",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    }
  ]
}