{
    "name": "nreljed/marketing-module",
    "description": "Marketing automation and social publishing feature for the Nreljed dashboard platform (social accounts, scheduled posts, campaigns, audience segments, contact tagging, workflow automation and engagement analytics).",
    "version": "0.5.0",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Nreljed"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0",
        "laravel/socialite": "^5.31",
        "nreljed/platform": "^0.1",
        "socialiteproviders/instagram": "^5.2",
        "socialiteproviders/pinterest": "^4.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Nreljed\\MarketingModule\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nreljed\\MarketingModule\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nreljed\\MarketingModule\\MarketingServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/nreljed/platform.git"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
