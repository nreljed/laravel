{
  "name": "nreljed/booking-module",
  "description": "Booking & properties feature for the Nreljed dashboard platform (property listings, availability calendar, bookings pipeline, guest portal, iCal sync, payments).",
  "version": "0.1.41",
  "type": "library",
  "license": "proprietary",
  "authors": [
    {
      "name": "Nreljed"
    }
  ],
  "require": {
    "php": "^8.4",
    "laravel/framework": "^13.0",
    "nreljed/platform": "^0.1"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Nreljed\\BookingModule\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Nreljed\\BookingModule\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Nreljed\\BookingModule\\Properties\\PropertiesServiceProvider",
        "Nreljed\\BookingModule\\Booking\\BookingServiceProvider"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/nreljed/platform.git"
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true
}
