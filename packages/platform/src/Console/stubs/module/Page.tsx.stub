import { Head } from "@inertiajs/react";
import AuthenticatedLayout from "@nreljed/platform/Layouts/AuthenticatedLayout";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@nreljed/platform/Components/ui/card";

interface {{ name }}IndexProps {
    items: unknown[];
}

/**
 * The {{ name }} landing page.
 *
 * Rendered by `{{ controllerClass }}::index()` as the Inertia component
 * `{{ pageName }}`. Replace the placeholder card with the module's real UI -
 * the surrounding chrome (sidebar, top bar, breadcrumbs, dark mode) comes from
 * the platform's AuthenticatedLayout, so there is nothing else to wire.
 */
export default function {{ name }}Index({ items }: {{ name }}IndexProps) {
    return (
        <AuthenticatedLayout
            header={<h2 className="text-xl font-semibold leading-tight text-foreground">{{ name }}</h2>}
        >
            <Head title="{{ name }}" />

            <div className="py-8">
                <div className="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                    <Card>
                        <CardHeader>
                            <CardTitle>{{ name }} is wired up</CardTitle>
                            <CardDescription>
                                This page was scaffolded by <code>php artisan make:module {{ name }}</code>. Edit{" "}
                                <code>src/Resources/js/Pages/Index.tsx</code> to build the module UI.
                            </CardDescription>
                        </CardHeader>
                        <CardContent>
                            <p className="text-sm text-muted-foreground">
                                {items.length === 0
                                    ? "No records yet. Add a model, a migration and a controller action to get started."
                                    : `${items.length} record(s).`}
                            </p>
                        </CardContent>
                    </Card>
                </div>
            </div>
        </AuthenticatedLayout>
    );
}
