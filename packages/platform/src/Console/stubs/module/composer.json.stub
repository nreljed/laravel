{
    "name": "{{ package }}",
    "description": "{{ name }} feature module for the Nreljed dashboard platform.",
    "version": "{{ version }}",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "{{ vendor }}"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0",
        "nreljed/platform": ">=0.3 <1.0"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "{{ namespaceJson }}\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "{{ namespaceJson }}\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "{{ namespaceJson }}\\{{ providerClass }}"
            ]
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/nreljed/platform.git"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
