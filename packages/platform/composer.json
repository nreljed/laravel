{
  "name": "nreljed/platform",
  "description": "SaaS platform kernel for Laravel apps (auth, RBAC, admin, settings, media, deploy, AI, notifications).",
  "version": "0.1.48",
  "type": "library",
  "license": "proprietary",
  "authors": [
    {
      "name": "Nreljed"
    }
  ],
  "require": {
    "php": "^8.4",
    "inertiajs/inertia-laravel": "^3.0",
    "intervention/image-laravel": "^4.0",
    "laravel/ai": "^0.10",
    "laravel/framework": "^13.0",
    "laravel/sanctum": "^4.0",
    "minishlink/web-push": "^11.0",
    "tightenco/ziggy": "^2.6"
  },
  "require-dev": {
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Nreljed\\Platform\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Nreljed\\Platform\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Nreljed\\Platform\\PlatformServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
