APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://laravel.tunispromo.tn

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=advertis_lara584
DB_USERNAME=advertis_lara584
DB_PASSWORD=

# Destructive database reset UI stays locked down in production. Set to true ONLY
# when you need the GitHub Actions reset workflow to run against this environment.
DB_MAINTENANCE_ENABLED=false

# Automated database backups (database:backup + /deploy/backup). Dumps gzip into
# DB_BACKUP_DIR (relative to storage/) and prunes to DB_BACKUP_KEEP after each run.
DB_BACKUP_ENABLED=true
# DB_BACKUP_DIR=app/backups
# DB_BACKUP_KEEP=7
# DB_BACKUP_SCHEDULE=03:17
# If mysqldump is not on PATH on the shared host, point at the full binary:
# DB_BACKUP_MYSQLDUMP=/usr/local/bin/mysqldump

# Sentry error/performance monitoring (optional — app boots fine without it).
SENTRY_LARAVEL_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.2
# SENTRY_RELEASE=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.tunispromo.tn

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mail.tunispromo.tn
MAIL_PORT=587
MAIL_USERNAME=contact@tunispromo.tn
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contact@tunispromo.tn"
MAIL_FROM_NAME="Cost Breaker 360"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Shared host: no persistent Node process, so Inertia SSR is OFF. Flip to true
# ONLY if the host can keep `node bootstrap/ssr/ssr.js` running (not cPanel/shared).
INERTIA_SSR_ENABLED=false

# Bootstrap admin (created on deploy if not exists)
ADMIN_EMAIL=nstudio.webdesign@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=nstudio

DEPLOY_TOKEN=