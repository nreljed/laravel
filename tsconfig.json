{
  "compilerOptions": {
    "allowJs": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "target": "ESNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": false,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@nreljed/blog/*": ["./packages/blog/src/Resources/js/*"],
      "@nreljed/platform/*": ["./packages/platform/resources/js/*"],
      "@test-posts": ["./app/TestPosts/Resources/js"],
      "@test-posts/*": ["./app/TestPosts/Resources/js/*"]
    }
  },
  "include": [
    "resources/js/**/*.ts",
    "resources/js/**/*.tsx",
    "resources/js/**/*.d.ts",
    "app/TestPosts/Resources/js/**/*.ts",
    "app/TestPosts/Resources/js/**/*.tsx",
    "app/TestPosts/Resources/js/**/*.d.ts",
    "packages/platform/resources/js/**/*.d.ts",
    "packages/blog/src/Resources/js/**/*.d.ts"
  ]
}