{
  "compilerOptions": {
    "allowJs": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "target": "ESNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": false,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@dashboard/*": ["./vendor/nreljed/dashboard-core/resources/js/*"],
      "@dashboard-posts/*": ["./vendor/nreljed/dashboard-core/src/Posts/Resources/js/*"],
      "@/*": ["./vendor/nreljed/dashboard-core/resources/js/*"],
      "ziggy-js": ["./vendor/tightenco/ziggy"]
    }
  },
  "include": [
    "resources/js/**/*.ts",
    "resources/js/**/*.tsx",
    "resources/js/**/*.d.ts",
    "vendor/nreljed/dashboard-core/resources/js/**/*.ts",
    "vendor/nreljed/dashboard-core/resources/js/**/*.tsx",
    "vendor/nreljed/dashboard-core/resources/js/**/*.d.ts",
    "vendor/nreljed/dashboard-core/src/**/Resources/js/**/*.ts",
    "vendor/nreljed/dashboard-core/src/**/Resources/js/**/*.tsx",
    "vendor/nreljed/dashboard-core/src/**/Resources/js/**/*.d.ts",
    "app/TestPosts/Resources/js/**/*.ts",
    "app/TestPosts/Resources/js/**/*.tsx",
    "app/TestPosts/Resources/js/**/*.d.ts"
  ]
}
