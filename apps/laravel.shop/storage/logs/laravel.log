    .email-footer a { color:#71717a; text-decoration:underline; }
    h1 { font-size:22px; font-weight:700; margin:0 0 16px; color:#18181b; }
    h2 { font-size:18px; font-weight:600; margin:0 0 12px; color:#18181b; }
