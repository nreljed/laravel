{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint resources/js/",
    "lint:fix": "eslint resources/js/ --fix",
    "format": "prettier --write \"resources/js/**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --check \"resources/js/**/*.{ts,tsx,json,css}\"",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "check:ci": "npm run lint && npm run typecheck && npm run format:check && npm run test && php vendor/bin/pint && php artisan test",
    "check:core-deps": "node scripts/check-core-deps.js",
    "check:platform-consistency": "node scripts/check-platform-consistency.js",
    "playwright:clean-output": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/playwright-clean.ps1 -Target output",
    "playwright:clean-pngs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/playwright-clean.ps1 -Target pngs",
    "playwright:clean-profiles": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/playwright-clean.ps1 -Target profiles",
    "playwright:clean-npx": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/playwright-clean.ps1 -Target npx",
    "playwright:clean-all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/playwright-clean.ps1 -Target all",
    "playwright:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/playwright-doctor.ps1",
    "build:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-deploy-zip.ps1 -Force"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ],
    "*.php": [
      "vendor/bin/pint"
    ]
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "fast-uri": "3.1.9",
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.0",
    "@emnapi/core": "^1.11.1",
    "@emnapi/runtime": "^1.11.1",
    "@eslint-react/eslint-plugin": "^5.23.5",
    "@inertiajs/core": "^3.8.0",
    "@inertiajs/react": "^3.8.0",
    "@inertiajs/vite": "^3.8.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "laravel-vite-plugin": "^3.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "semver": "^7.7.0",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^3.1.0",
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.20",
    "@geoman-io/leaflet-geoman-free": "^2.20.2",
    "@lexical/code": "^0.53.0",
    "@lexical/code-shiki": "^0.53.0",
    "@lexical/dragon": "^0.53.0",
    "@lexical/extension": "^0.53.0",
    "@lexical/history": "^0.53.0",
    "@lexical/html": "^0.53.0",
    "@lexical/link": "^0.53.0",
    "@lexical/list": "^0.53.0",
    "@lexical/markdown": "^0.53.0",
    "@lexical/overflow": "^0.53.0",
    "@lexical/react": "^0.53.0",
    "@lexical/rich-text": "^0.53.0",
    "@lexical/selection": "^0.53.0",
    "@lexical/table": "^0.53.0",
    "@lexical/utils": "^0.53.0",
    "@shadcn/react": "^0.3.1",
    "@shikijs/engine-javascript": "^4.5.0",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.0.0",
    "@tanstack/react-table": "^9.2.4",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.2",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "leaflet": "^1.9.4",
    "leaflet.fullscreen": "^5.3.3",
    "leaflet.markercluster": "^1.5.3",
    "lexical": "^0.53.0",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^1.51.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.1",
    "react-hook-form": "^7.89.0",
    "react-is": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-phone-number-input": "^3.4.18",
    "react-resizable-panels": "^4.14.2",
    "recharts": "^3.10.1",
    "shiki": "^4.5.0",
    "tw-animate-css": "^1.4.0",
    "ziggy-js": "^2.6.4",
    "zod": "^4.6.6"
  }
}
