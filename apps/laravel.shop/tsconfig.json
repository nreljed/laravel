{
  "compilerOptions": {
    "allowJs": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "target": "ESNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": false,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@nreljed/platform/*": ["../../packages/platform/resources/js/*"],
      "@nreljed/blog/*": ["../../packages/blog/src/Resources/js/*"],
      "@nreljed/shop-module/*": ["../../packages/shop-module/src/Resources/js/*"]
    }
  },
  "include": [
    "resources/js/**/*.ts",
    "resources/js/**/*.tsx",
    "resources/js/**/*.d.ts",
    "../../packages/platform/resources/js/**/*.d.ts",
    "../../packages/blog/src/Resources/js/**/*.d.ts",
    "../../packages/shop-module/src/Resources/js/**/*.d.ts"
  ]
}
