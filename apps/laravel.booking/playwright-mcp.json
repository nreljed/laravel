{
  "$schema": "https://raw.githubusercontent.com/microsoft/playwright-mcp/main/config.schema.json",
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": {
      "headless": false,
      "args": [
        "--disable-features=OptimizationGuideModelDownloading,OptimizationHints,OptimizationTargetPrediction,OptimizationGuideFetching",
        "--disable-component-update",
        "--disable-background-networking",
        "--disable-sync",
        "--disable-default-apps",
        "--no-first-run"
      ]
    },
    "contextOptions": {
      "viewport": { "width": 1920, "height": 1080 },
      "locale": "en-US"
    }
  },
  "server": {
    "allowedHosts": ["*"]
  },
  "capabilities": ["core", "network", "storage", "testing"],
  "timeouts": {
    "action": 10000,
    "navigation": 30000,
    "expect": 10000
  },
  "outputDir": "./storage/debug/playwright-output",
  "outputMaxSize": 52428800,
  "saveSession": false,
  "snapshot": {
    "mode": "full"
  }
}
